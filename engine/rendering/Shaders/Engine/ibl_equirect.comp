#version 450
#extension GL_GOOGLE_include_directive : require
#include "zodar/ibl_common.glsl"

// Equirectangular HDR image -> cube map mip 0.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray target;
layout(push_constant) uniform Push { uint size; } pc;

void main() {
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, uvec2(pc.size)))) return;
    vec3 d = texelDirection(gl_GlobalInvocationID, pc.size);
    imageStore(target, ivec3(gl_GlobalInvocationID), vec4(textureLod(source, equirectUv(d), 0.0).rgb, 1.0));
}
